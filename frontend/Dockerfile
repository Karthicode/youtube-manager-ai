# ============================================================
# Stage 1: deps
# Install production dependencies in isolation so this
# expensive layer is cached as long as bun.lock doesn't change.
# ============================================================
FROM node:20-alpine AS deps

WORKDIR /app

# Bun as package manager only — Node stays the actual JS runtime for the
# build/start steps (bun respects the `#!/usr/bin/env node` shebang on the
# `next` CLI and shells out to this Node binary instead of using its own
# runtime). Pinned to the current stable release, not a canary.
RUN npm install -g bun@1.3.14

COPY package.json bun.lock ./

# bun install --frozen-lockfile is the bun equivalent of npm ci (reproducible,
# fails if the lockfile is out of date). --production skips devDependencies
# (biome, @types, etc.) — bun's equivalent of npm ci --omit=dev.
RUN bun install --frozen-lockfile --production


# ============================================================
# Stage 2: builder
# Compile the Next.js app. This stage has full node_modules
# (deps + devDeps) because the build tool (TypeScript, Biome,
# PostCSS) lives in devDependencies.
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g bun@1.3.14

# Copy lock files and install ALL dependencies (including dev)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy the rest of the source
COPY . .

# NEXT_PUBLIC_* variables are inlined at build time by webpack.
# They become string literals in the JS bundle — NOT runtime env vars.
# The value must be what the browser will actually call, which means
# it must go through the Ingress (an externally-resolvable hostname),
# NOT an internal Kubernetes service DNS name like backend-svc:8000.
#
# Default: http://youtube-manager.local/api/v1
# Override at build time: docker build --build-arg NEXT_PUBLIC_API_URL=...
ARG NEXT_PUBLIC_API_URL=http://youtube-manager.local/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN bun run build


# ============================================================
# Stage 3: runner
# Minimal production image. Only the standalone server output
# is copied here — no node_modules, no source files.
#
# The standalone output (produced by output:'standalone' in
# next.config.ts) includes:
#   .next/standalone/         ← self-contained Node server + minimal deps
#   .next/static/             ← compiled JS/CSS (must be copied separately)
#   public/                   ← static assets served by Next.js
# ============================================================
FROM node:20-alpine AS runner

WORKDIR /app

# Create a non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

# Copy the standalone server bundle
COPY --from=builder /app/.next/standalone ./

# Copy static assets (CSS, JS chunks, images)
# These must live at .next/static/ relative to the server root
COPY --from=builder /app/.next/static ./.next/static

# Copy public/ (favicon, etc.)
COPY --from=builder /app/public ./public

USER appuser

EXPOSE 3000

# server.js is the entry point generated by Next.js standalone mode.
# It respects PORT and HOSTNAME env vars at runtime (unlike NEXT_PUBLIC_*).
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
