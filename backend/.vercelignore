# Ignore development files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.env.local
*.log

# Note: pyproject.toml is needed for zero-config deployment (defines app entrypoint)
# Only ignore poetry.lock as Vercel uses requirements.txt
poetry.lock

# Ignore test files
tests/
.pytest_cache/
.coverage

# Ignore alembic migration files (migrations should be run manually in production)
alembic/
alembic.ini

# Ignore IDE
.vscode/
.idea/
*.swp
*.swo

# Ignore git
.git/
.gitignore

# Ignore old vercel files
vercel_app.py
