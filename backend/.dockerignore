# Environment files — never bake secrets into an image
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
tests/

# Type / lint caches
.mypy_cache/
.ruff_cache/

# Vercel serverless entry point (not used in Kubernetes)
index.py
vercel.json

# Poetry lockfile (requirements.txt is used for the Docker build)
poetry.lock
pyproject.toml

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Docs
*.md
docs/
